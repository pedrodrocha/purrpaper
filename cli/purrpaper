#!/usr/bin/env bash
set -euo pipefail

# Bootstrap -----------------------------------------------------------------

APP_NAME="purrpaper"
SOURCE="${BASH_SOURCE[0]}"
if command -v readlink >/dev/null 2>&1; then
  SOURCE="$(readlink -f -- "$SOURCE")"
fi

CLI_DIR="$(cd -- "$(dirname -- "$SOURCE")" && pwd)"
APP_DIR="$(cd -- "$CLI_DIR/.." && pwd)"
CONTROL="$APP_DIR/scripts/control"

# Presentation --------------------------------------------------------------

if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  BOLD=$'\033[1m'
  RESET=$'\033[0m'
  MAUVE=$'\033[38;2;203;166;247m'
  PINK=$'\033[38;2;245;194;231m'
  BLUE=$'\033[38;2;137;180;250m'
  GREEN=$'\033[38;2;166;227;161m'
  YELLOW=$'\033[38;2;249;226;175m'
  PEACH=$'\033[38;2;250;179;135m'
  RED=$'\033[38;2;243;139;168m'
  TEXT=$'\033[38;2;205;214;244m'
  SUBTEXT=$'\033[38;2;166;173;200m'
else
  BOLD=""; RESET=""; MAUVE=""; PINK=""; BLUE=""; GREEN=""; YELLOW=""; PEACH=""; RED=""; TEXT=""; SUBTEXT=""
fi

CAT="󰄛"
TAGLINE="tiny wallpaper magic for Catppuccin Omarchy"

# Output helpers ------------------------------------------------------------

say() { printf '%b\n' "$*"; }
say_err() { printf '%b\n' "$*" >&2; }

label() {
  printf '%b%-18s%b %s\n' "$BLUE" "$1" "$RESET" "$2"
}

success() {
  say "${GREEN}${CAT}${RESET} ${TEXT}$*${RESET}"
}

warn() {
  say "${YELLOW}☾${RESET} ${PEACH}$*${RESET}"
}

cat_note() {
  say "${MAUVE}${CAT}${RESET} ${TEXT}$*${RESET}"
}

disabled() {
  say "${RED}${CAT}${RESET} ${TEXT}$*${RESET}"
}

fail() {
  local message="$1" code="${2:-1}"

  say_err "${RED}✗${RESET} ${TEXT}$message${RESET}"
  exit "$code"
}

# Formatting helpers --------------------------------------------------------

pretty_path() {
  local path="$1"

  case "$path" in
    "$HOME") printf '~' ;;
    "$HOME"/*) printf '~/%s' "${path#"$HOME"/}" ;;
    *) printf '%s' "$path" ;;
  esac
}

human_duration() {
  local minutes="$1"

  if (( minutes % 1440 == 0 )); then
    local days=$(( minutes / 1440 ))
    (( days == 1 )) && echo "1 day" || echo "$days days"
  elif (( minutes % 60 == 0 )); then
    local hours=$(( minutes / 60 ))
    (( hours == 1 )) && echo "1 hour" || echo "$hours hours"
  else
    (( minutes == 1 )) && echo "1 minute" || echo "$minutes minutes"
  fi
}

human_seconds() {
  local seconds="$1"
  local days=$(( seconds / 86400 ))
  local hours=$(( (seconds % 86400) / 3600 ))
  local minutes=$(( (seconds % 3600) / 60 ))

  if (( days > 0 )); then
    echo "${days}d ${hours}h"
  elif (( hours > 0 )); then
    echo "${hours}h ${minutes}m"
  elif (( minutes > 0 )); then
    echo "${minutes}m"
  else
    echo "now"
  fi
}

# Duration parsing ----------------------------------------------------------

duration_minutes() {
  local value="${1:-}"

  case "$value" in
    hourly|hour) echo 60; return 0 ;;
    daily|day) echo 1440; return 0 ;;
  esac

  if [[ "$value" =~ ^[0-9]+$ ]]; then
    echo "$value"
  elif [[ "$value" =~ ^([0-9]+)m(in|inute|inutes)?$ ]]; then
    echo "${BASH_REMATCH[1]}"
  elif [[ "$value" =~ ^([0-9]+)h(our|ours)?$ ]]; then
    echo "$(( BASH_REMATCH[1] * 60 ))"
  elif [[ "$value" =~ ^([0-9]+)d(ay|ays)?$ ]]; then
    echo "$(( BASH_REMATCH[1] * 1440 ))"
  else
    fail "duration must look like ${MAUVE}30m${RESET}, ${MAUVE}4h${RESET}, ${MAUVE}1d${RESET}, ${MAUVE}hourly${RESET}, or ${MAUVE}daily${RESET}." 2
  fi
}

# Usage ---------------------------------------------------------------------

usage() {
  cat <<EOF
${BOLD}${MAUVE}${CAT} $APP_NAME${RESET} ${SUBTEXT}— $TAGLINE${RESET}

${BOLD}Usage:${RESET} purrpaper <command> [value]

${BOLD}Commands:${RESET}
  ${MAUVE}status${RESET}              Show a readable status summary
  ${MAUVE}status --json${RESET}       Show raw widget/control JSON
  ${MAUVE}rotate${RESET}              Pick and apply a wallpaper now
  ${MAUVE}save${RESET}                Save the current wallpaper as a favorite
  ${MAUVE}enable | on${RESET}         Enable automatic rotation
  ${MAUVE}disable | off${RESET}       Disable automatic rotation
  ${MAUVE}toggle${RESET}              Toggle automatic rotation
  ${MAUVE}every <duration>${RESET}    Set the rotation interval: 30m, 4h, 1d, daily, hourly
  ${MAUVE}sooner <duration>${RESET}   Shorten the interval by that duration
  ${MAUVE}later <duration>${RESET}    Lengthen the interval by that duration
  ${MAUVE}open${RESET}                Open the current wallpaper file
  ${MAUVE}remove${RESET}              Remove the CLI link, then remove the Omarchy plugin
  ${MAUVE}unlink${RESET}              Remove only the CLI link
  ${MAUVE}help${RESET}                Show this help

${BOLD}Examples:${RESET}
  ${SUBTEXT}purrpaper status${RESET}
  ${SUBTEXT}purrpaper rotate${RESET}
  ${SUBTEXT}purrpaper save${RESET}
  ${SUBTEXT}purrpaper every 4h${RESET}
  ${SUBTEXT}purrpaper every daily${RESET}
  ${SUBTEXT}purrpaper sooner 1h${RESET}

${MAUVE}${CAT}${RESET} ${SUBTEXT}Durations understand 30m, 4h, 1d, hourly, and daily.${RESET}
EOF
}

# Control script access -----------------------------------------------------

need_control() {
  [[ -x "$CONTROL" ]] || fail "missing control script: ${SUBTEXT}$CONTROL${RESET}" 1
}

control_status_json() {
  "$CONTROL" status
}

# Status rendering ----------------------------------------------------------

print_status() {
  local json enabled interval current theme catppuccin no_internet rotating remaining
  local saved_dir cache_dir

  json="$(control_status_json)"
  enabled="$(jq -r 'if .enabled then "enabled" else "disabled" end' <<<"$json")"
  interval="$(jq -r '.intervalMinutes' <<<"$json")"
  current="$(jq -r '.currentName // ""' <<<"$json")"
  theme="$(jq -r '.currentTheme // ""' <<<"$json")"
  catppuccin="$(jq -r '.catppuccinActive' <<<"$json")"
  no_internet="$(jq -r '.noInternet' <<<"$json")"
  rotating="$(jq -r '.rotating' <<<"$json")"
  remaining="$(jq -r '.remainingSeconds' <<<"$json")"
  saved_dir="$HOME/.config/omarchy/backgrounds/catppuccin"
  cache_dir="$HOME/.config/omarchy/backgrounds/catppuccin/pedrodrocha.purrpaper"

  [[ -n "$current" ]] || current="none"
  [[ -n "$theme" ]] || theme="unknown"

  say "${BOLD}${MAUVE}${CAT} Purrpaper${RESET} ${SUBTEXT}— $TAGLINE${RESET}"
  if [[ "$enabled" == "enabled" ]]; then
    label "Status" "${GREEN}enabled${RESET} ${SUBTEXT}(${CAT} softly shuffling pixels)${RESET}"
  else
    label "Status" "${RED}disabled${RESET} ${SUBTEXT}(${CAT} napping)${RESET}"
  fi

  label "Wallpaper" "${PINK}$current${RESET}"
  label "Theme" "${MAUVE}$theme${RESET}"
  label "Interval" "${TEXT}$(human_duration "$interval")${RESET}"
  label "Next rotation" "${TEXT}$(human_seconds "$remaining")${RESET}"
  label "Favorites" "${SUBTEXT}$(pretty_path "$saved_dir")${RESET}"
  label "Cache" "${SUBTEXT}$(pretty_path "$cache_dir")${RESET}"

  [[ "$catppuccin" == true ]] || warn "rotation is paused because the active theme is not catppuccin."
  [[ "$no_internet" == true ]] && warn "the last gallery/download check failed."
  [[ "$rotating" == true ]] && warn "a rotation is currently running."
}

# Command actions -----------------------------------------------------------

set_interval() {
  local minutes="$1"

  "$CONTROL" interval "$minutes" >/dev/null
  success "Interval set to ${MAUVE}$(human_duration "$minutes")${TEXT}. ${SUBTEXT}${CAT} will keep time.${TEXT}"
}

rotate_now() {
  local output wallpaper skipped no_internet

  output="$("$CONTROL" rotate)"
  wallpaper="$(printf '%s\n' "$output" | sed -n 's/^Rotated to: //p' | tail -1)"
  skipped="$(printf '%s\n' "$output" | sed -n 's/^Skipped: //p' | tail -1)"
  no_internet="$(printf '%s\n' "$output" | sed -n 's/^No internet: //p' | tail -1)"

  if [[ -n "$wallpaper" ]]; then
    success "Now wearing ${PINK}$wallpaper${TEXT}. ${SUBTEXT}${CAT} fresh pixels, fresh mood.${TEXT}"
  elif [[ -n "$skipped" ]]; then
    warn "Rotation skipped: ${TEXT}$skipped ${SUBTEXT}${CAT} stayed put.${PEACH}"
  elif [[ -n "$no_internet" ]]; then
    warn "No internet: ${TEXT}$no_internet ${SUBTEXT}${CAT} waiting for signal.${PEACH}"
  else
    success "${output:-Rotated.} ${SUBTEXT}${CAT} fresh pixels, fresh mood.${TEXT}"
  fi
}

save_current() {
  local output saved_path already_path

  output="$("$CONTROL" save)"
  saved_path="$(printf '%s\n' "$output" | sed -n 's/^Saved current background to: //p' | tail -1)"
  already_path="$(printf '%s\n' "$output" | sed -n 's/^Already saved: //p' | tail -1)"

  if [[ -n "$saved_path" ]]; then
    success "Saved ${PINK}$(basename -- "$saved_path")${TEXT} to your favorites. ${SUBTEXT}${CAT} good catch.${TEXT}"
    label "Favorites" "${SUBTEXT}$(pretty_path "$(dirname -- "$saved_path")")${RESET}"
  elif [[ -n "$already_path" ]]; then
    success "${PINK}$(basename -- "$already_path")${TEXT} was already in your favorites. ${SUBTEXT}${CAT} still a good pick.${TEXT}"
    label "Favorites" "${SUBTEXT}$(pretty_path "$(dirname -- "$already_path")")${RESET}"
  else
    success "${output:-Saved current wallpaper.} ${SUBTEXT}${CAT} good catch.${TEXT}"
  fi
}

enable_rotation() {
  "$CONTROL" enable >/dev/null
  success "Automatic rotation ${GREEN}enabled${TEXT}. ${SUBTEXT}${CAT} back on wallpaper duty.${TEXT}"
}

disable_rotation() {
  "$CONTROL" disable >/dev/null
  disabled "Automatic rotation ${RED}disabled${TEXT}. ${SUBTEXT}${CAT} curled up under a Mocha blanket.${TEXT}"
}

toggle_rotation() {
  local json

  json="$("$CONTROL" toggle)"
  if [[ "$(jq -r '.enabled' <<<"$json")" == true ]]; then
    success "Automatic rotation ${GREEN}enabled${TEXT}. ${SUBTEXT}${CAT} back on wallpaper duty.${TEXT}"
  else
    disabled "Automatic rotation ${RED}disabled${TEXT}. ${SUBTEXT}${CAT} curled up under a Mocha blanket.${TEXT}"
  fi

  say ""
  print_status
}

shift_interval() {
  local direction="$1" minutes="$2"

  case "$direction" in
    sooner)
      "$CONTROL" interval-delta "-$minutes" >/dev/null
      success "Pulled the next shuffle ${MAUVE}$(human_duration "$minutes")${TEXT} closer. ${SUBTEXT}${CAT} impatient in the best way.${TEXT}"
      ;;
    later)
      "$CONTROL" interval-delta "$minutes" >/dev/null
      success "Gave the current wallpaper ${MAUVE}$(human_duration "$minutes")${TEXT} more time. ${SUBTEXT}${CAT} let it linger.${TEXT}"
      ;;
  esac

  print_status
}

open_current() {
  local json current_path current_name

  json="$(control_status_json)"
  current_path="$(jq -r '.current // ""' <<<"$json")"
  current_name="$(jq -r '.currentName // ""' <<<"$json")"

  "$CONTROL" open-current
  [[ -n "$current_name" ]] || current_name="current wallpaper"
  success "Opened ${PINK}$current_name${TEXT}. ${SUBTEXT}${CAT} take a closer look.${TEXT}"
  [[ -n "$current_path" ]] && label "Path" "${SUBTEXT}$(pretty_path "$current_path")${RESET}"
}

remove_plugin() {
  cat_note "Cleaning up the cozy pawprints..."
  "$APP_DIR/uninstall.sh" "$@"
}

unlink_cli() {
  cat_note "Removing the purrpaper command link..."
  "$APP_DIR/uninstall.sh" --cli-only
}

# CLI dispatch --------------------------------------------------------------

command="${1:-status}"
case "$command" in
  help|-h|--help)
    usage
    exit 0
    ;;
  remove)
    remove_plugin "${@:2}"
    exit 0
    ;;
  unlink)
    unlink_cli
    exit 0
    ;;
esac

need_control

case "$command" in
  status)
    if [[ "${2:-}" == "--json" ]]; then
      control_status_json | jq .
    else
      print_status
    fi
    ;;
  rotate)
    rotate_now
    ;;
  save)
    save_current
    ;;
  enable|on)
    enable_rotation
    ;;
  disable|off)
    disable_rotation
    ;;
  toggle)
    toggle_rotation
    ;;
  every|interval)
    set_interval "$(duration_minutes "${2:-}")"
    ;;
  sooner|later)
    shift_interval "$command" "$(duration_minutes "${2:-}")"
    ;;
  open|open-current)
    open_current
    ;;
  *)
    warn "Unknown command: ${MAUVE}$command${RESET}"
    usage >&2
    exit 2
    ;;
esac
